# Voorbeeld voor android/keystore.properties — het echte bestand staat in
# .gitignore en wordt NOOIT gecommit.
#
# Gebruik: kopieer dit bestand naar android/keystore.properties en vul je eigen
# waarden in. Ontbreekt keystore.properties, dan slaat build.gradle de signing
# over en blijven debug-builds werken.
#
# storeFile: gebruik een ABSOLUUT pad. file() resolvet relatieve paden tegen
# android/app/, niet tegen de repo-root — en de keystore hoort buiten de repo.
storeFile=/absoluut/pad/naar/sellqo-upload.jks
storePassword=VERVANG_MIJ
keyAlias=upload
keyPassword=VERVANG_MIJ
