# Copy to .env and fill in values for your Lovable Cloud / Supabase project.
# All values below are PUBLIC (anon key + project URL/ID) — safe to share.
# Never put service-role keys, Stripe secrets, Resend keys, or webhook secrets here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=your-project-id